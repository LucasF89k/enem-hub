# quais variaveis o app precisa.
!.env.example

# vercel
.vercel

# Claude Code (config/estado local da ferramenta de IA)
/.claude/

# material de estudo bruto importado (PDFs, .apkg, etc — não versionar)
/fonte de conteudo/

# typescript
*.tsbuildinfo
next-env.d.ts
/scripts/.claude-extract/

# Design work (mockups, artboards) — não versionar
.design-work/
backup-cjk-antes.json
backup-antes-travessao.json
design-reference/

# Trabalho de correcao de gabaritos (nao versionar)
backup-gabaritos-antes-ia.json
