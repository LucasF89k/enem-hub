# Modelo das variáveis de ambiente do Vion.
#
# Copie este arquivo para `.env` e preencha os valores. O `.env` de verdade
# NUNCA vai pro git (está no .gitignore) porque tem segredos. Este `.example`
# existe só pra listar o que precisa ser configurado, sem expor nada.
#
# Marcação:
#   [obrigatório] o app não sobe / a função quebra sem isto
#   [opcional]    tem fallback ou é uma melhoria


# ── Banco de dados (Neon) ─────────────────────────────────────────────
# [obrigatório] String de conexão do PostgreSQL.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"


# ── Autenticação (NextAuth) ───────────────────────────────────────────
# [obrigatório] Segredo pra assinar os cookies de sessão. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""
# [obrigatório] URL base do app (em dev, http://localhost:3000).
NEXTAUTH_URL="http://localhost:3000"
# URL pública do app, usada em links de e-mail. Igual à de cima em dev.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [opcional] Login com Google. Sem isto, só funciona login por e-mail/senha.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ── E-mail (Resend) ───────────────────────────────────────────────────
# [obrigatório PARA "esqueci a senha"] Sem esta chave, o envio de e-mail
# quebra e a recuperação de senha não funciona. Crie a conta em resend.com,
# gere a API Key (começa com re_) e cole aqui.
RESEND_API_KEY=""
# Remetente dos e-mails. Pra testar, "onboarding@resend.dev" funciona mas só
# entrega pro e-mail da sua própria conta Resend. Pra enviar pra qualquer
# aluno, verifique um domínio próprio no Resend e troque por algo como
# "Vion <nao-responda@seudominio.com.br>".
EMAIL_FROM="Vion <onboarding@resend.dev>"


# ── Inteligência artificial ───────────────────────────────────────────
# [obrigatório PARA o Mentor/correção] O app alterna entre MiMo (Xiaomi) e
# Gemini (Google). Pelo menos um dos provedores precisa estar configurado.
MIMO_API_KEY=""
# [opcional] Várias chaves MiMo separadas por vírgula, pra rotação de cota.
MIMO_API_KEYS=""
# [opcional] Alternativa ao MiMo direto: usar o MiMo via OpenRouter (paga em
# USD). Se preenchida, tem prioridade sobre a MIMO_API_KEY.
OPENROUTER_API_KEY=""
# Chave do Google Gemini (fallback do Mentor e usada na recalibração do plano).
GEMINI_API_KEY=""
# [opcional] Várias chaves Gemini separadas por vírgula, pra rotação de cota.
GEMINI_API_KEYS=""


# ── YouTube (vídeoaulas) ──────────────────────────────────────────────
# [obrigatório PARA buscar/atualizar vídeos] Chave da YouTube Data API v3.
# Usada por `npm run search-videos` e `npm run refresh-videos`. O app exibe
# os vídeos por embed mesmo sem ela; ela só é preciso pra popular/atualizar.
YOUTUBE_API_KEY=""


# ── Imagens (Cloudinary) ──────────────────────────────────────────────
# [opcional] Armazenamento de imagens. A foto de perfil hoje é salva como
# data URL no banco, então isto não é crítico pro fluxo básico.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""


# ── Rate limiting robusto (Upstash Redis) ─────────────────────────────
# [opcional] Sem estas duas, o rate limiting cai pro modo em memória (funciona,
# mas não segura ataque distribuído entre instâncias). Com elas, fica robusto.
# Ver src/lib/rate-limit.ts.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
